# Copy to .env.local and fill in values from your Supabase project + Stripe later.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (local or production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe billing
# 1. Create a Product + recurring Price ($12/mo) in Stripe Dashboard
# 2. Copy the Price ID (price_...) into STRIPE_PRICE_ID_PRO
# 3. Developers → API keys for secret + publishable
# 4. Developers → Webhooks → Add endpoint:
#    https://YOUR_DOMAIN/api/billing/webhook
#    Events: checkout.session.completed, customer.subscription.updated,
#            customer.subscription.deleted
# 5. Local test: stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO=

# Cron (Vercel sets Authorization: Bearer $CRON_SECRET automatically)
CRON_SECRET=generate-a-long-random-string

# Email alerts for scheduled scans (optional — Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ScanCraft <onboarding@resend.dev>

# Optional: GitHub OAuth is configured in the Supabase dashboard
# (Authentication → Providers → GitHub), not here.
